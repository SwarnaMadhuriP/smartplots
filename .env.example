# SmartPlots local development

# Local PostgreSQL from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartplots

# Gemini Developer API key from Google AI Studio.
# GOOGLE_API_KEY also works.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=False

# Local frontend URL used by backend CORS.
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend should point to local backend in development.
NEXT_PUBLIC_BACKENDAPI_BASE_URL=http://localhost:8000
